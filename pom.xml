<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.joutvhu</groupId>
    <artifactId>javadec-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>javadec-parent</name>
    <description>Universal and selective Java Decompiler for AI &amp; Developers</description>

    <modules>
        <module>javadec-core</module>
        <module>javadec-cli</module>
        <module>javadec-mcp</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <picocli.version>4.7.6</picocli.version>
        <asm.version>9.7</asm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.joutvhu</groupId>
                <artifactId>javadec-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- Copy shaded jars into jars/ during package phase -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.basedir}/jars"/>
                                <copy file="${project.basedir}/javadec-cli/target/javadec-cli-${project.version}.jar" tofile="${project.basedir}/jars/javadec-cli.jar" failonerror="false"/>
                                <copy file="${project.basedir}/javadec-cli/target/javadec-cli.jar" tofile="${project.basedir}/jars/javadec-cli.jar" failonerror="false"/>
                                <copy file="${project.basedir}/javadec-mcp/target/javadec-mcp-${project.version}.jar" tofile="${project.basedir}/jars/javadec-mcp.jar" failonerror="false"/>
                                <copy file="${project.basedir}/javadec-mcp/target/javadec-mcp.jar" tofile="${project.basedir}/jars/javadec-mcp.jar" failonerror="false"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
